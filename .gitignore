# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Environment ───────────────────────────────────────
.env
.env.*
*.key
*.secret
venv/
.venv/
env/

# ── Papers (copyright protected — do not upload) ──────
*.pdf
projects/*/papers/*
!projects/*/papers/.gitkeep

# ── Index storage (auto-generated, large binary files) ─
projects/*/index_storage/*
!projects/*/index_storage/.gitkeep

# ── VL output (images extracted from papers) ──────────
projects/*/vl_test_output/*
!projects/*/vl_test_output/.gitkeep

# ── Paper metadata (derived from paper content) ───────
projects/*/papers_metadata.json

# ── Eval result data (contains verbatim/derived paper content) ─
eval/results/*.json
# Per-run debug artifacts can contain long verbatim paper excerpts.
eval/results/*/
# Generated manual-model inputs/outputs are local; keep only the script and summary.
eval/chatgpt_answers_*.jsonl
eval/chatgpt_prompts_*.md
eval/chatgpt_raw_*.txt
# Invalid A/B: Stage 4 generated Chinese, so this was not the intended English-only probe.
eval/results/eval_q08_comparison_json_validator_enonly.md

# ── ChromaDB memory (personal session data) ───────────
memory_db/
!memory_db/.gitkeep
*.chroma
e--Projects-rag-project/
.codex/project-memory.md

# ── Internal dev docs ─────────────────────────────────
pipeline_v2_task_spec.md

# ── Logs ──────────────────────────────────────────────
*.log
logs/

# ── OS / Editor ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
